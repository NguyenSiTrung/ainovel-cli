  "$defs": {
    "engine_ping_request": {
      "title": "engine.ping request payload",
      "description": "Liveness check. No arguments; send {}.",
      "type": "object"
    },
    "engine_shutdown_request": {
      "title": "engine.shutdown request payload",
      "description": "Graceful shutdown request. The engine replies ok:true, flushes state, and exits; the supervisor waits out its grace period before force-termination.",
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "description": "Optional human-readable reason recorded in logs."
        }
      }
    },
    "project_create_request": {
      "title": "project.create request payload",
      "description": "Create a new project at a directory chosen via the native file dialog.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute path of the directory in which to create the project."
        },
        "name": {
          "type": "string",
          "description": "Optional project display name."
        },
        "options": {
          "type": "object",
          "description": "Optional loose bag of engine creation options; contents follow the Go engine and are not enumerated here."
        }
      },
      "required": [
