{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Novel Desktop",
  "version": "0.1.0",
  "identifier": "dev.ainovel.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Novel",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ainovel-engine"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "AI-assisted novel writing workspace",
    "longDescription": "AI Novel Desktop is the graphical face of the ainovel-cli Go engine: create and open novel projects, run and steer generation, inspect progress, and export finished chapters.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
